# İbnüssebil API
# Copy to .env for local overrides.

DATABASE_URL=sqlite:///./ibnussebil.db
JWT_SECRET=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Leave empty to use the Haversine fallback for optimization
# (works with zero services). Example: http://localhost:5000
OSRM_BASE_URL=

# Road-following map line. If OSRM_BASE_URL is set it is used first.
# Default is the public OSRM demo server (fine for demos, not for production).
# Set empty to show straight fallback lines.
ROUTE_GEOMETRY_BASE_URL=https://router.project-osrm.org
ROUTE_GEOMETRY_TIMEOUT_SECONDS=10

# Free Photon geocoder. Disable if you only use Excel rows with lat/lon.
GEOCODING_ENABLED=true
GEOCODER_URL=https://photon.komoot.io/api

OPTIMIZER_TIME_LIMIT_SECONDS=5
MAX_IMPORT_ROWS=1000
