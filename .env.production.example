# Production environment for ibnussebil.com
# Copy to .env and fill JWT_SECRET.
# Generate with: openssl rand -hex 32

JWT_SECRET=
CORS_ORIGINS=https://ibnussebil.com

# Keep true for v1. Photon is a free public geocoder; self-host later if needed.
GEOCODING_ENABLED=true

# Public OSRM demo server is used for road-following map geometry.
# For real optimization quality, self-host OSRM and set OSRM_BASE_URL.
ROUTE_GEOMETRY_BASE_URL=https://router.project-osrm.org
OSRM_BASE_URL=
